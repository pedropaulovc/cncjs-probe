{
  "name": "cncjs-probe",
  "version": "0.1.1",
  "description": "Touch plate and tool length probing CNCjs custom widget, ported from gSender's Probe tool, that counts a FluidNC toolsetter (Pn:T) as a touch.",
  "keywords": [
    "cncjs",
    "cnc",
    "probe",
    "touch-plate",
    "g-code",
    "grbl",
    "fluidnc",
    "widget"
  ],
  "license": "GPL-3.0-only",
  "author": "Pedro Paulo Vezza Campos <pedro@vezza.com.br>",
  "homepage": "https://github.com/pedropaulovc/cncjs-probe#readme",
  "bugs": {
    "url": "https://github.com/pedropaulovc/cncjs-probe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedropaulovc/cncjs-probe.git"
  },
  "exports": {
    "./index.html": "./web/index.html",
    "./package.json": "./package.json"
  },
  "files": [
    "web",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "pack:check": "npm pack --dry-run",
    "test": "node --test \"test/*.test.mjs\""
  },
  "type": "module",
  "devDependencies": {
    "bootstrap": "3.3.7",
    "ensure-type": "1.5.1",
    "esbuild": "0.28.2",
    "escodegen": "1.11.1",
    "esprima": "4.0.1",
    "gcode-parser": "2.2.0",
    "lodash": "4.17.21",
    "playwright": "1.64.1"
  }
}
